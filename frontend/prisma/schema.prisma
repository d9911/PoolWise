// PoolWise Prisma schema — PostgreSQL.
// Money is ALWAYS stored as integer minor units (amountMinor) to avoid float drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  role         UserRole      @default(USER)
  bets         Bet[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([role])
}

model Market {
  id                String        @id @default(cuid())
  question          String
  status            MarketStatus  @default(OPEN)
  outcome           Outcome?
  rakeBps           Int           @default(800)
  initialYesProbBps Int           @default(6500)
  poolYesMinor      Int           @default(0)
  poolNoMinor       Int           @default(0)
  bets              Bet[]
  transactions      Transaction[]
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
}

model Bet {
  id             String   @id @default(cuid())
  userId         String
  marketId       String
  side           Outcome
  amountMinor    Int
  idempotencyKey String   @unique
  user           User     @relation(fields: [userId], references: [id])
  market         Market   @relation(fields: [marketId], references: [id])
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([marketId])
  @@index([side])
}

model Transaction {
  id             String          @id @default(cuid())
  userId         String?
  marketId       String?
  betId          String?
  type           TransactionType
  amountMinor    Int
  idempotencyKey String          @unique
  user           User?           @relation(fields: [userId], references: [id])
  market         Market?         @relation(fields: [marketId], references: [id])
  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([marketId])
  @@index([type])
}

enum UserRole {
  USER
  ADMIN
  HOUSE
}

enum MarketStatus {
  OPEN
  RESOLVED
}

enum Outcome {
  YES
  NO
}

enum TransactionType {
  DEPOSIT
  BET_PLACED
  PAYOUT_RECEIVED
  RAKE_COLLECTED
  HOUSE_COVERED
}
