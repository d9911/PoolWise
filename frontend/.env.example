# Database connection (used by Prisma).
# For local Docker (make docker-up) this matches docker-compose.yml.
# For local Node dev (make dev) point this at your local Postgres.
DATABASE_URL="postgresql://poolwise:poolwise@localhost:5432/poolwise?schema=public"

# Which user the UI assumes by default for the demo (no real auth in MVP).
NEXT_PUBLIC_DEMO_USER_ID="alice"

# BPS = basis points. 800 bps = 8% rake.
NEXT_PUBLIC_DEFAULT_RAKE_BPS="800"

# Idempotency key prefix for bets created from the UI.
NEXT_PUBLIC_BET_KEY_PREFIX="bet-ui"
